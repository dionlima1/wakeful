    },
    "External display, power, Wi‑Fi, apps, video calls and schedules.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاشة خارجية وطاقة وWi‑Fi وتطبيقات ومكالمات فيديو وجداول زمنية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla externa, corrent, Wi‑Fi, apps, videotrucades i horaris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Externí monitor, napájení, Wi‑Fi, aplikace, videohovory a plány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstern skærm, strøm, Wi-Fi, apps, videoopkald og tidsplaner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externer Bildschirm, Strom, WLAN, Apps, Videoanrufe und Zeitpläne."
