          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зовнішній дисплей, живлення, Wi‑Fi, програми, відеодзвінки й розклади."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
