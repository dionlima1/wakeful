          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar eksternal, daya, Wi‑Fi, app, panggilan video, dan jadwal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor esterno, alimentazione, Wi‑Fi, app, videochiamate e orari."
          }
        },
        "ja": {
