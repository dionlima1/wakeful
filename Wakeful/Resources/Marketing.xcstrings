{
  "sourceLanguage": "en",
  "strings": {
    "Automatic, when it matters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقائي، عندما يهم الأمر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Automàtic, quan importa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky, když na tom záleží."
          }
        },
        "da": {
          "stringUnit": {
