          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstern skjerm, strøm, Wi-Fi, apper, videosamtaler og tidsplaner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extern beeldscherm, stroom, wifi, apps, videogesprekken en schema's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor zewnętrzny, zasilanie, Wi‑Fi, aplikacje, wideorozmowy i harmonogramy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor externo, energia, Wi‑Fi, apps, videochamadas e horários."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor externo, energia, Wi‑Fi, apps, videochamadas e horários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor extern, alimentare, Wi‑Fi, aplicații, apeluri video și programe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внешний дисплей, питание, Wi‑Fi, приложения, видеозвонки и расписания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Externý monitor, napájanie, Wi‑Fi, aplikácie, videohovory a plány."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Extern skärm, ström, wifi, appar, videosamtal och scheman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จอภาพภายนอก พลังงาน Wi‑Fi แอป การโทรวิดีโอ และกำหนดการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
