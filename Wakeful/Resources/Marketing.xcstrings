        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξωτερική οθόνη, ρεύμα, Wi‑Fi, εφαρμογές, βιντεοκλήσεις και προγράμματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla externa, corriente, Wi‑Fi, apps, videollamadas y horarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulkoinen näyttö, virta, Wi-Fi, apit, videopuhelut ja aikataulut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écran externe, secteur, Wi‑Fi, apps, visioconférences et horaires."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסך חיצוני, חשמל, Wi‑Fi, יישומים, שיחות וידאו ולוחות זמנים."
