	<string>Wakeful uses your location only so macOS lets it read the name of your Wi‑Fi network for Wi‑Fi triggers. Your location is never stored or shared.</string>
	<key>WakefulAppGroup</key>
	<string>$(TeamIdentifierPrefix)com.dionlima.wakeful</string>
