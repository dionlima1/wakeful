    "Leave empty to keep awake indefinitely.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغًا لإبقائه مستيقظًا إلى أجل غير مسمى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa-ho buit per mantenir-lo despert indefinidament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechte prázdné, chcete-li Mac nechat vzhůru neomezeně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad være tomt for at holde vågen på ubestemt tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um unbegrenzt wach zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε κενό για εγρήγορση επ’ αόριστον."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para mantenerlo despierto indefinidamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä tyhjäksi, niin Mac pysyy hereillä toistaiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour garder éveillé indéfiniment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר ריק כדי להשאיר ער ללא הגבלת זמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनिश्चित काल तक जगाए रखने के लिए खाली छोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostavite prazno za neograničeno držanje budnim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyja üresen a határozatlan ideig tartó ébren tartáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosongkan untuk menjaga tetap terjaga tanpa batas waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per mantenerlo sveglio a tempo indeterminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にすると無期限にスリープさせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 무기한 깨어 있게 유지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk terus berjaga tanpa had masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La stå tomt for å holde våken på ubestemt tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om voor onbepaalde tijd wakker te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby nie usypiać bezterminowo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para manter acordado por tempo indeterminado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para manter acordado indefinidamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lăsați gol pentru a menține treaz pe termen nelimitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы не давать уснуть бессрочно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte prázdne, ak chcete Mac nechať hore neobmedzene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för att hålla vaken på obestämd tid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว้นว่างไว้เพื่อให้ตื่นอยู่ไม่มีกำหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süresiz olarak uyanık tutmak için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб не давати заснути безстроково."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để giữ thức vô thời hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则无限期保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即無限期保持喚醒。"
          }
        }
      }
    },
