    "See how long your Mac stayed awake, and why.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف كم بقي الـ Mac مستيقظًا ولماذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta quant de temps ha estat despert el Mac i per què."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjistěte, jak dlouho a proč byl Mac vzhůru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvor længe Mac'en var vågen, og hvorfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir an, wie lange dein Mac wach war und warum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε πόση ώρα έμεινε το Mac σε εγρήγορση και γιατί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cuánto tiempo estuvo despierto el Mac y por qué."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näe, kuinka kauan Mac oli hereillä ja miksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez combien de temps le Mac est resté éveillé, et pourquoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראה כמה זמן ה‑Mac נשאר ער, ולמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि Mac कितनी देर जगा रहा, और क्यों।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte koliko je dugo Mac bio budan i zašto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézze meg, mennyi ideig és miért volt ébren a Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berapa lama Mac Anda terjaga, dan alasannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri per quanto tempo il Mac è rimasto sveglio e perché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがどれくらいの時間、なぜ起動していたかを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 얼마나 오래, 왜 깨어 있었는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berapa lama Mac anda berjaga, dan sebabnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvor lenge Macen var våken, og hvorfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie hoelang je Mac wakker bleef, en waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, jak długo Mac nie spał i dlaczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quanto tempo o Mac ficou acordado e por quê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quanto tempo o Mac esteve acordado e porquê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți cât timp a stat Mac‑ul treaz și de ce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, как долго Mac не спал и почему."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zistite, ako dlho a prečo bol Mac hore."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hur länge datorn var vaken, och varför."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่า Mac ตื่นอยู่นานเท่าใดและเพราะอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’in ne kadar süre ve neden uyanık kaldığını görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся, як довго Mac не спав і чому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem máy Mac đã thức bao lâu và vì sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Mac 保持唤醒了多久,以及原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Mac 保持喚醒了多久,以及原因。"
          }
        }
      }
    },
    "See whether your Mac is kept awake and switch it with one click.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف ما إذا كان الـ Mac مستيقظًا وبدّل الحالة بنقرة واحدة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova si el Mac es manté despert i canvia-ho amb un clic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjistěte, zda je Mac držen vzhůru, a přepínejte jedním kliknutím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, om din Mac holdes vågen, og skift med ét klik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, ob dein Mac wach gehalten wird, und schalte mit einem Klick um."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε αν το Mac μένει σε εγρήγορση και αλλάξτε το με ένα κλικ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si el Mac se mantiene despierto y cámbialo con un clic."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näe, pidetäänkö Macia hereillä, ja vaihda yhdellä klikkauksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez si votre Mac est maintenu éveillé et basculez en un clic."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראה אם ה‑Mac נשאר ער ושנה בלחיצה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि Mac जगाया जा रहा है या नहीं, और एक क्लिक में बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte drži li se Mac budnim i promijenite jednim klikom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézze meg, hogy a Mac ébren van-e tartva, és váltson egy kattintással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat apakah Mac Anda dijaga tetap terjaga dan ubah dengan satu klik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri se il Mac viene mantenuto sveglio e cambialo con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのスリープが防止されているかを確認し、ワンクリックで切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 깨어 있게 유지되는지 확인하고 한 번의 클릭으로 전환하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat sama ada Mac anda dipastikan berjaga dan tukar dengan satu klik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se om Macen holdes våken, og bytt med ett klikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie of je Mac wakker wordt gehouden en schakel met één klik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy Mac nie jest usypiany, i przełączaj jednym kliknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja se o Mac está sendo mantido acordado e alterne com um clique."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja se o Mac está a ser mantido acordado e alterne com um clique."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedeți dacă Mac‑ul este menținut treaz și comutați cu un clic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, не дают ли Mac уснуть, и переключайте одним нажатием."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zistite, či je Mac držaný hore, a prepínajte jedným kliknutím."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se om datorn hålls vaken och växla med ett klick."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่า Mac ถูกให้ตื่นอยู่หรือไม่ และสลับได้ในคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’in uyanık tutulup tutulmadığını görün ve tek tıkla değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся, чи не дають Mac заснути, і перемикайте одним клацанням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem máy Mac có đang được giữ thức không và chuyển đổi chỉ với một lần bấm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Mac 是否保持唤醒,一键切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 Mac 是否保持喚醒,一鍵切換。"
          }
        }
      }
