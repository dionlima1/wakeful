{
  "sourceLanguage": "en",
  "strings": {
    "%@ finished. Your Mac can sleep again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى %@. يمكن للـ Mac الدخول في وضع السكون مجددًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha acabat. El Mac pot tornar a repòs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ skončil. Mac může znovu usnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er færdig. Mac'en må gå i dvale igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist fertig. Dein Mac darf wieder ruhen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ ολοκληρώθηκε. Το Mac μπορεί πάλι να μπει σε ύπνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha terminado. El Mac puede volver a reposo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on valmis. Mac voi taas mennä lepoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est terminé. Le Mac peut de nouveau se mettre en veille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הסתיים. ה‑Mac יכול לישון שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूरा हुआ। Mac फिर से स्लीप हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je završio. Mac ponovno može prijeći u pripravno stanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ befejeződött. A Mac újra alhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ selesai. Mac Anda boleh tidur lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha terminato. Il Mac può tornare in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が終了しました。Macは再びスリープできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 작업이 끝났습니다. Mac이 다시 잠자기에 들어갈 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ selesai. Mac anda boleh tidur semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er ferdig. Macen kan gå i dvale igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is klaar. Je Mac mag weer sluimeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zakończył pracę. Mac może znów zostać uśpiony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminou. O Mac pode repousar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminou. O Mac pode voltar a entrar em pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s-a terminat. Mac‑ul poate intra din nou în repaus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ завершен. Mac снова может уснуть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ skončil. Mac môže znova zaspať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är klar. Datorn får vila igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ทำงานเสร็จแล้ว Mac สามารถพักเครื่องได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bitti. Mac yeniden uyuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ завершено. Mac знову може заснути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã hoàn tất. Máy Mac có thể ngủ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已完成。Mac 可以重新睡眠了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已完成。Mac 可以再次睡眠了。"
          }
        }
      }
    },
