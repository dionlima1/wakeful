    "%@ quit. Your Mac can sleep again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنهاء %@. يمكن للـ Mac الدخول في وضع السكون مجددًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’ha tancat. El Mac pot tornar a repòs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ byla ukončena. Mac může znovu usnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev afsluttet. Mac'en må gå i dvale igen."
          }
        },
