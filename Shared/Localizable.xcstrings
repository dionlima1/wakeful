            "value": "คลิกเพื่อให้ตื่นอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık tutmak için tıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть, щоб не давати заснути"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm để giữ thức"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以保持唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下以保持喚醒"
          }
        }
      }
    },
    "Comma-separated process names. Wakeful checks every few seconds and lets the Mac sleep again once they all finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء عمليات مفصولة بفواصل. يتحقق Wakeful كل بضع ثوانٍ ويسمح للـ Mac بالدخول في وضع السكون مجددًا عند انتهائها جميعًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms de processos separats per comes. El Wakeful comprova cada pocs segons i deixa que el Mac torni a repòs quan tots han acabat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy procesů oddělené čárkou. Wakeful kontroluje každých pár sekund a jakmile všechny skončí, nechá Mac znovu přejít do režimu spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesnavne adskilt med komma. Wakeful tjekker med få sekunders mellemrum og lader Mac'en gå i dvale igen, når de alle er færdige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozessnamen durch Kommas getrennt. Wakeful prüft alle paar Sekunden und lässt den Mac wieder ruhen, sobald alle fertig sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ονόματα διεργασιών χωρισμένα με κόμμα. Το Wakeful ελέγχει κάθε λίγα δευτερόλεπτα και αφήνει ξανά το Mac να μπει σε ύπνο όταν τελειώσουν όλοι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres de procesos separados por comas. Wakeful comprueba cada pocos segundos y deja que el Mac vuelva a reposo cuando todos terminan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosessinimet pilkuilla erotettuina. Wakeful tarkistaa muutaman sekunnin välein ja antaa Macin mennä taas lepoon, kun kaikki ovat valmiita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms de processus séparés par des virgules. Wakeful vérifie toutes les quelques secondes et laisse le Mac se mettre en veille une fois qu’ils ont tous terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמות תהליכים מופרדים בפסיקים. Wakeful בודק כל כמה שניות ומאפשר ל‑Mac לעבור שוב למצב שינה כשכולם מסיימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉमा से अलग किए गए प्रोसेस के नाम। Wakeful हर कुछ सेकंड में जाँच करता है और सबके पूरा होने पर Mac को फिर से स्लीप होने देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazivi procesa odvojeni zarezom. Wakeful provjerava svakih nekoliko sekundi i ponovno dopušta Macu da prijeđe u pripravno stanje kad svi završe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesszővel elválasztott folyamatnevek. A Wakeful néhány másodpercenként ellenőriz, és ha mind végzett, újra engedi a Mac alvását."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama proses yang dipisahkan koma. Wakeful memeriksa setiap beberapa detik dan membiarkan Mac tidur lagi setelah semuanya selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi dei processi separati da virgole. Wakeful controlla ogni pochi secondi e lascia andare il Mac in stop quando hanno finito tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセス名をカンマで区切って入力します。Wakefulは数秒ごとに確認し、すべて終了するとMacを再びスリープできるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표로 구분된 프로세스 이름입니다. Wakeful은 몇 초마다 확인하고, 모두 끝나면 Mac이 다시 잠자기에 들어갈 수 있게 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama proses dipisahkan dengan koma. Wakeful menyemak setiap beberapa saat dan membenarkan Mac tidur semula setelah semuanya selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosessnavn atskilt med komma. Wakeful sjekker med noen sekunders mellomrom og lar Macen gå i dvale igjen når alle er ferdige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procesnamen gescheiden door komma's. Wakeful controleert om de paar seconden en laat de Mac weer sluimeren zodra ze allemaal klaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy procesów rozdzielone przecinkami. Wakeful sprawdza co kilka sekund i pozwala Macowi znów przejść w stan uśpienia, gdy wszystkie się zakończą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes de processos separados por vírgula. O Wakeful verifica a cada poucos segundos e deixa o Mac repousar de novo quando todos terminam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes de processos separados por vírgulas. O Wakeful verifica a cada poucos segundos e deixa o Mac entrar em pausa quando todos terminarem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nume de procese separate prin virgulă. Wakeful verifică la câteva secunde și lasă Mac‑ul să intre din nou în repaus după ce toate se termină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена процессов через запятую. Wakeful проверяет каждые несколько секунд и снова разрешает Mac уснуть, когда все они завершатся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy procesov oddelené čiarkou. Wakeful kontroluje každých pár sekúnd a keď všetky skončia, nechá Mac znova prejsť do režimu spánku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Processnamn avgränsade med komman. Wakeful kontrollerar med några sekunders mellanrum och låter datorn vila igen när alla är klara."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อโปรเซสคั่นด้วยจุลภาค Wakeful จะตรวจสอบทุกๆ ไม่กี่วินาทีและปล่อยให้ Mac พักเครื่องได้อีกครั้งเมื่อทั้งหมดทำงานเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgülle ayrılmış işlem adları. Wakeful birkaç saniyede bir kontrol eder ve hepsi bitince Mac’in yeniden uyumasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви процесів через кому. Wakeful перевіряє кожні кілька секунд і знову дозволяє Mac заснути, коли всі вони завершаться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên tiến trình phân tách bằng dấu phẩy. Wakeful kiểm tra vài giây một lần và cho phép máy Mac ngủ lại khi tất cả đã xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用逗号分隔的进程名称。Wakeful 每隔几秒检查一次,全部完成后让 Mac 恢复正常睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗號分隔的程序名稱。Wakeful 每隔幾秒檢查一次,全部完成後讓 Mac 恢復正常睡眠。"
          }
        }
      }
    },
