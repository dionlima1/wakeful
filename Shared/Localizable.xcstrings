    "One purchase. No subscription. Shared with your family.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية شراء واحدة. بلا اشتراك. مشاركة مع عائلتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola compra. Sense subscripció. Compartida amb la família."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden nákup. Žádné předplatné. Sdíleno s rodinou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét køb. Intet abonnement. Deles med familien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf. Kein Abo. Mit deiner Familie geteilt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία αγορά. Χωρίς συνδρομή. Κοινή χρήση με την οικογένεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola compra. Sin suscripción. Compartida con tu familia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi osto. Ei tilausta. Jaetaan perheen kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat. Sans abonnement. Partagé avec votre famille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכישה אחת. ללא מינוי. משותף עם המשפחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ख़रीदारी। कोई सब्सक्रिप्शन नहीं। परिवार के साथ शेयर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna kupnja. Bez pretplate. Dijeli se s obitelji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszeri vásárlás. Nincs előfizetés. Megosztható a családdal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kali beli. Tanpa langganan. Dibagikan dengan keluarga Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo acquisto. Nessun abbonamento. Condiviso con la tua famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の購入。サブスクリプションなし。ファミリーと共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구입. 구독 없음. 가족과 공유."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu pembelian. Tiada langganan. Dikongsi dengan keluarga anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kjøp. Ingen abonnement. Delt med familien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén aankoop. Geen abonnement. Gedeeld met je gezin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zakup. Bez subskrypcji. Udostępniany rodzinie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra. Sem assinatura. Compartilhada com sua família."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra. Sem subscrição. Partilhada com a sua família."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O singură achiziție. Fără abonament. Partajată cu familia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка. Без подписки. Доступно семье."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden nákup. Žiadne predplatné. Zdieľané s rodinou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett köp. Ingen prenumeration. Delas med familjen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว ไม่มีการสมัครรับ แชร์กับครอบครัวได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek satın alım. Abonelik yok. Ailenizle paylaşılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка. Без підписки. Доступно родині."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Không đăng ký. Chia sẻ với gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买,无需订阅,可与家人共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單次購買,無需訂閱,可與家人共享。"
          }
        }
      }
    },
