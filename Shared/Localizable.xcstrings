    "History is stored only on this Mac and is never sent anywhere.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن السجل على هذا الـ Mac فقط ولا يُرسَل إلى أي مكان أبدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historial només es desa en aquest Mac i mai no s’envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie se ukládá jen na tomto Macu a nikam se neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Historikken gemmes kun på denne Mac og sendes aldrig nogen steder hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf bleibt nur auf diesem Mac und wird nie irgendwohin gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ιστορικό αποθηκεύεται μόνο σε αυτό το Mac και δεν αποστέλλεται ποτέ πουθενά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se guarda solo en este Mac y nunca se envía a ningún sitio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia tallennetaan vain tähän Maciin, eikä sitä lähetetä minnekään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique reste uniquement sur ce Mac et n’est jamais envoyé nulle part."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההיסטוריה נשמרת רק ב‑Mac זה ולעולם אינה נשלחת לשום מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास केवल इसी Mac पर संग्रहित होता है और कभी कहीं नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povijest se pohranjuje samo na ovom Macu i nikamo se ne šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előzmények csak ezen a Macen tárolódnak, és sehová sem kerülnek elküldésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat hanya disimpan di Mac ini dan tidak pernah dikirim ke mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia resta solo su questo Mac e non viene mai inviata altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はこのMacにのみ保存され、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 Mac에만 저장되며 어디로도 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah disimpan pada Mac ini sahaja dan tidak pernah dihantar ke mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loggen lagres bare på denne Macen og sendes aldri noe sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geschiedenis blijft alleen op deze Mac en wordt nooit ergens heen gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia jest przechowywana tylko na tym Macu i nigdy nie jest nigdzie wysyłana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico fica apenas neste Mac e nunca é enviado a lugar nenhum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico fica apenas neste Mac e nunca é enviado para lado nenhum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul este stocat doar pe acest Mac și nu este trimis nicăieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История хранится только на этом Mac и никуда не отправляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "História sa ukladá len na tomto Macu a nikam sa neposiela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Historiken lagras bara på den här datorn och skickas aldrig någonstans."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติจะถูกเก็บไว้บน Mac เครื่องนี้เท่านั้นและจะไม่ถูกส่งไปที่ใดเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş yalnızca bu Mac’te saklanır ve hiçbir yere gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія зберігається лише на цьому Mac і ніколи нікуди не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử chỉ được lưu trên máy Mac này và không bao giờ được gửi đi đâu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录仅存储在这台 Mac 上,绝不会发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史記錄只會儲存在這部 Mac 上,絕不會傳送到任何地方。"
          }
        }
      }
    },
