    "Is Mac Kept Awake?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يُبقى الـ Mac مستيقظًا؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac es manté despert?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac držen vzhůru?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdes Mac'en vågen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird der Mac wach gehalten?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μένει το Mac σε εγρήγορση;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Se mantiene el Mac despierto?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidetäänkö Mac hereillä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac est-il maintenu éveillé ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם ה‑Mac נשאר ער?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या Mac जगाया जा रहा है?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži li se Mac budnim?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébren van tartva a Mac?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Mac Dijaga Tetap Terjaga?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac viene mantenuto sveglio?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのスリープを防止中?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 깨어 있게 유지되고 있습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah Mac Dipastikan Berjaga?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdes Macen våken?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt de Mac wakker gehouden?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy Mac nie jest usypiany?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac Está Sendo Mantido Acordado?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac está a ser mantido acordado?"
          }
        },
