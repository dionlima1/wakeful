    "No triggers yet. Add one to keep the Mac awake automatically in certain situations.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مشغّلات بعد. أضف مشغّلًا لإبقاء الـ Mac مستيقظًا تلقائيًا في حالات معينة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha activadors. Afegeix-ne un per mantenir el Mac despert automàticament en certes situacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné spouštěče. Přidejte spouštěč, který v určitých situacích automaticky nenechá Mac usnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen udløsere endnu. Tilføj en for automatisk at holde Mac'en vågen i bestemte situationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Auslöser. Füge einen hinzu, um den Mac in bestimmten Situationen automatisch wach zu halten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη εναύσματα. Προσθέστε ένα για να μένει αυτόματα το Mac σε εγρήγορση σε ορισμένες καταστάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay activadores. Añade uno para mantener el Mac despierto automáticamente en ciertas situaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä laukaisimia. Lisää laukaisin, jotta Mac pysyy automaattisesti hereillä tietyissä tilanteissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun déclencheur pour l’instant. Ajoutez-en un pour garder le Mac éveillé automatiquement dans certaines situations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין טריגרים. הוסף טריגר כדי להשאיר את ה‑Mac ער באופן אוטומטי במצבים מסוימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई ट्रिगर नहीं है। कुछ स्थितियों में Mac को अपने आप जगाए रखने के लिए एक ट्रिगर जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema okidača. Dodajte jedan kako bi Mac u određenim situacijama automatski ostao budan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek eseményindítók. Adjon hozzá egyet, hogy a Mac bizonyos helyzetekben automatikusan ébren maradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pemicu. Tambahkan satu agar Mac tetap terjaga secara otomatis dalam situasi tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun attivatore. Aggiungine uno per mantenere il Mac sveglio automaticamente in certe situazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガーはまだありません。追加すると、特定の状況でMacを自動的にスリープさせないようにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 트리거가 없습니다. 트리거를 추가하면 특정 상황에서 Mac을 자동으로 깨어 있게 유지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada pencetus. Tambah satu untuk memastikan Mac berjaga secara automatik dalam situasi tertentu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen utløsere ennå. Legg til én for å holde Macen våken automatisk i bestemte situasjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen triggers. Voeg er een toe om de Mac in bepaalde situaties automatisch wakker te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze wyzwalaczy. Dodaj wyzwalacz, aby w określonych sytuacjach automatycznie nie usypiać Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum gatilho ainda. Adicione um para manter o Mac acordado automaticamente em certas situações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há acionadores. Adicione um para manter o Mac acordado automaticamente em certas situações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există declanșatori. Adăugați unul pentru a menține automat Mac‑ul treaz în anumite situații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Триггеров пока нет. Добавьте триггер, чтобы Mac автоматически не засыпал в определенных ситуациях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne spúšťače. Pridajte spúšťač, ktorý v určitých situáciách automaticky nenechá Mac zaspať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga utlösare än. Lägg till en för att hålla datorn vaken automatiskt i vissa situationer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตัวกระตุ้น เพิ่มตัวกระตุ้นเพื่อให้ Mac ตื่นอยู่โดยอัตโนมัติในบางสถานการณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz tetikleyici yok. Belirli durumlarda Mac’i otomatik olarak uyanık tutmak için bir tane ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тригерів поки немає. Додайте тригер, щоб Mac автоматично не засинав у певних ситуаціях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có trình kích hoạt nào. Thêm một trình kích hoạt để tự động giữ máy Mac thức trong một số tình huống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有触发条件。添加一个,即可在特定情况下自动让 Mac 保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無觸發條件。加入一個,即可在特定情況下自動讓 Mac 保持喚醒。"
          }
        }
      }
    },
