    "Thank you for supporting an independent developer!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لدعمك مطوّرًا مستقلًا!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gràcies per donar suport a un desenvolupador independent!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Děkujeme, že podporujete nezávislého vývojáře!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, fordi du støtter en uafhængig udvikler!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du einen unabhängigen Entwickler unterstützt!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε που στηρίζετε έναν ανεξάρτητο προγραμματιστή!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por apoyar a un desarrollador independiente!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos, että tuet itsenäistä kehittäjää!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de soutenir un développeur indépendant !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה שאתה תומך במפתח עצמאי!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्वतंत्र डेवलपर को सपोर्ट करने के लिए धन्यवाद!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala što podržavate neovisnog developera!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönjük, hogy egy független fejlesztőt támogat!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih telah mendukung pengembang independen!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per sostenere uno sviluppatore indipendente!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人開発者を応援していただきありがとうございます!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독립 개발자를 응원해 주셔서 감사합니다!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih kerana menyokong pembangun bebas!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du støtter en uavhengig utvikler!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt voor het steunen van een onafhankelijke ontwikkelaar!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za wspieranie niezależnego twórcy!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por apoiar um desenvolvedor independente!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por apoiar um programador independente!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă mulțumim că sprijiniți un dezvoltator independent!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо за поддержку независимого разработчика!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďakujeme, že podporujete nezávislého vývojára!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du stöder en oberoende utvecklare!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่สนับสนุนนักพัฒนาอิสระ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız bir geliştiriciyi desteklediğiniz için teşekkürler!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо за підтримку незалежного розробника!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã ủng hộ một nhà phát triển độc lập!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你支持独立开发者!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝你支持獨立開發者!"
          }
        }
      }
    },
