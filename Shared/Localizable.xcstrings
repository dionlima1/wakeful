    "Unlock automation, AI agent detection, history and more with a one-time purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح قفل الأتمتة واكتشاف وكلاء الذكاء الاصطناعي والسجل والمزيد بعملية شراء واحدة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueja l’automatització, la detecció d’agents d’IA, l’historial i més amb una sola compra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemkněte automatizaci, detekci AI agentů, historii a další funkce jednorázovým nákupem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås op for automatisering, registrering af AI-agenter, historik og mere med et engangskøb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Automatisierung, KI-Agenten-Erkennung, Verlauf und mehr mit einem einmaligen Kauf frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκλειδώστε αυτοματισμούς, ανίχνευση πρακτόρων AI, ιστορικό και πολλά άλλα με μία αγορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea la automatización, la detección de agentes de IA, el historial y más con una compra única."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa automaatio, tekoälyagenttien tunnistus, historia ja paljon muuta kertaostoksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez l’automatisation, la détection des agents IA, l’historique et plus encore avec un achat unique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל את הנעילה של אוטומציה, זיהוי סוכני AI, היסטוריה ועוד ברכישה חד‑פעמית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की ख़रीदारी से ऑटोमेशन, AI एजेंट पहचान, इतिहास और बहुत कुछ अनलॉक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otključajte automatizaciju, prepoznavanje AI agenata, povijest i više jednokratnom kupnjom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldja fel az automatizálást, az MI-ügynökök észlelését, az előzményeket és még sok mást egyszeri vásárlással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka otomatisasi, deteksi agen AI, riwayat, dan lainnya dengan satu kali pembelian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca automazione, rilevamento degli agenti IA, cronologia e altro con un unico acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の購入で、自動化、AIエージェントの検出、履歴などが利用できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구입으로 자동화, AI 에이전트 감지, 기록 등을 잠금 해제하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci automasi, pengesanan ejen AI, sejarah dan banyak lagi dengan satu pembelian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp automatisering, gjenkjenning av KI-agenter, logg og mer med ett enkelt kjøp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel automatisering, detectie van AI-agents, geschiedenis en meer met één aankoop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj automatyzację, wykrywanie agentów AI, historię i więcej dzięki jednorazowemu zakupowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie automação, detecção de agentes de IA, histórico e mais com uma compra única."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie automação, deteção de agentes de IA, histórico e muito mais com uma compra única."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocați automatizarea, detectarea agenților AI, istoricul și altele cu o singură achiziție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте автоматизацию, обнаружение ИИ-агентов, историю и многое другое разовой покупкой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odomknite automatizáciu, detekciu AI agentov, históriu a ďalšie funkcie jednorazovým nákupom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp automatisering, identifiering av AI-agenter, historik och mer med ett engångsköp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อคการทำงานอัตโนมัติ การตรวจจับเอเจนต์ AI ประวัติ และอีกมากมายด้วยการซื้อครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomasyonu, yapay zekâ ajanı algılamayı, geçmişi ve daha fazlasını tek seferlik bir satın alımla açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте автоматизацію, виявлення ШІ-агентів, історію та інше одноразовою покупкою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa tự động hóa, phát hiện tác nhân AI, lịch sử và nhiều tính năng khác chỉ với một lần mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买即可解锁自动化、AI 智能体检测、历史记录等功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單次購買即可解鎖自動化、AI 代理程式偵測、歷史記錄等功能。"
          }
        }
      }
    },
