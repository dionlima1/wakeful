    "Stay awake until a command, script or app finishes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى مستيقظًا حتى ينتهي أمر أو برنامج نصي أو تطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es manté despert fins que acaba una ordre, un script o una app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstane vzhůru, dokud neskončí příkaz, skript nebo aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbliver vågen, indtil en kommando, et script eller en app er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt wach, bis ein Befehl, Skript oder eine App fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μένει σε εγρήγορση μέχρι να ολοκληρωθεί μια εντολή, σενάριο ή εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece despierto hasta que termine un comando, script o app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysyy hereillä, kunnes komento, skripti tai appi on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste éveillé jusqu’à la fin d’une commande, d’un script ou d’une app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשאר ער עד שפקודה, סקריפט או יישום מסתיימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड, स्क्रिप्ट या ऐप पूरी होने तक जगा रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaje budan dok se naredba, skripta ili aplikacija ne završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébren marad, amíg egy parancs, szkript vagy app be nem fejeződik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap terjaga sampai perintah, skrip, atau app selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta sveglio finché un comando, uno script o un’app non termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド、スクリプト、アプリが終わるまでスリープしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령, 스크립트 또는 앱이 끝날 때까지 깨어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus berjaga sehingga arahan, skrip atau app selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forblir våken til en kommando, et skript eller en app er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft wakker tot een opdracht, script of app klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie usypia do zakończenia polecenia, skryptu lub aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica acordado até um comando, script ou app terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica acordado até um comando, script ou app terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămâne treaz până se termină o comandă, un script sau o aplicație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дает уснуть до завершения команды, скрипта или приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostane hore, kým neskončí príkaz, skript alebo aplikácia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förblir vaken tills ett kommando, skript eller en app är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตื่นอยู่จนกว่าคำสั่ง สคริปต์ หรือแอปจะทำงานเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komut, betik veya uygulama bitene kadar uyanık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дає заснути до завершення команди, скрипта чи програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn thức đến khi một lệnh, tập lệnh hoặc ứng dụng hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持唤醒,直到命令、脚本或 App 完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持喚醒,直到指令、腳本或 App 完成。"
          }
        }
      }
    },
    "Stays awake while Claude Code, Codex, Gemini or any agent you add is working.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى مستيقظًا أثناء عمل Claude Code أو Codex أو Gemini أو أي وكيل تضيفه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es manté despert mentre treballen el Claude Code, el Codex, el Gemini o qualsevol agent que afegeixis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstane vzhůru, dokud pracuje Claude Code, Codex, Gemini nebo jakýkoli agent, kterého přidáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbliver vågen, mens Claude Code, Codex, Gemini eller en anden agent, du tilføjer, arbejder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt wach, während Claude Code, Codex, Gemini oder ein anderer von dir hinzugefügter Agent arbeitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μένει σε εγρήγορση όσο εργάζονται το Claude Code, το Codex, το Gemini ή οποιοσδήποτε πράκτορας προσθέσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece despierto mientras trabajan Claude Code, Codex, Gemini o cualquier agente que añadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysyy hereillä, kun Claude Code, Codex, Gemini tai mikä tahansa lisäämäsi agentti työskentelee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste éveillé pendant que Claude Code, Codex, Gemini ou tout agent que vous ajoutez travaille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשאר ער בזמן ש‑Claude Code, Codex, Gemini או כל סוכן שתוסיף עובדים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक Claude Code, Codex, Gemini या आपके जोड़ा गया कोई एजेंट काम कर रहा है, जगा रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaje budan dok rade Claude Code, Codex, Gemini ili bilo koji agent koji dodate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébren marad, amíg a Claude Code, a Codex, a Gemini vagy bármely hozzáadott ügynök dolgozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap terjaga saat Claude Code, Codex, Gemini, atau agen apa pun yang Anda tambahkan sedang bekerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta sveglio mentre lavorano Claude Code, Codex, Gemini o qualsiasi agente aggiunto da te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code、Codex、Gemini、または追加した任意のエージェントが作業している間はスリープしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Gemini 또는 추가한 에이전트가 작업하는 동안 깨어 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus berjaga semasa Claude Code, Codex, Gemini atau mana-mana ejen yang anda tambah sedang bekerja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
