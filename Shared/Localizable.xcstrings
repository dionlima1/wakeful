    "Prevents your Mac from sleeping, optionally for a number of minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع الـ Mac من الدخول في وضع السكون، لعدد من الدقائق إن أردت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el Mac entri en repòs, opcionalment durant uns minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabrání přechodu Macu do režimu spánku, volitelně na zadaný počet minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhindrer, at Mac'en går i dvale, eventuelt i et antal minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass der Mac in den Ruhezustand wechselt – optional für eine bestimmte Anzahl Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτρέπει την κατάσταση ύπνου του Mac, προαιρετικά για συγκεκριμένα λεπτά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el Mac entre en reposo, opcionalmente durante unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estää Macia menemästä lepoon, valinnaisesti tietyksi minuuttimääräksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche le Mac de se mettre en veille, éventuellement pendant un nombre de minutes donné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מונע מה‑Mac לעבור למצב שינה, אופציונלית למספר דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac को स्लीप होने से रोकता है, चाहें तो कुछ मिनटों के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprječava prelazak Maca u pripravno stanje, po želji na određeni broj minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megakadályozza a Mac alvó állapotba kerülését, igény szerint adott számú percig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencegah Mac tidur, secara opsional selama beberapa menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce lo stop del Mac, facoltativamente per un certo numero di minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのスリープを防ぎます。分数を指定することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기에 들어가지 않게 합니다. 원하는 경우 분 단위로 설정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghalang Mac daripada tidur, secara pilihan untuk beberapa minit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrer at Macen går i dvale, eventuelt i et antall minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt dat de Mac gaat sluimeren, eventueel voor een aantal minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapobiega uśpieniu Maca, opcjonalnie przez określoną liczbę minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que o Mac entre em repouso, opcionalmente por alguns minutos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que o Mac entre em pausa, opcionalmente durante alguns minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împiedică intrarea Mac‑ului în repaus, opțional pentru un număr de minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дает Mac перейти в режим сна, при желании — на заданное число минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabráni prechodu Macu do režimu spánku, voliteľne na zadaný počet minút."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhindrar att datorn försätts i vila, eventuellt under ett antal minuter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้องกันไม่ให้ Mac พักเครื่อง โดยเลือกระบุจำนวนนาทีได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’in uyumasını önler; isteğe bağlı olarak belirli bir dakika boyunca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дає Mac перейти в режим сну, за бажанням — на задану кількість хвилин."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn máy Mac chuyển sang chế độ ngủ, có thể trong một số phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止 Mac 进入睡眠,可选择指定分钟数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
