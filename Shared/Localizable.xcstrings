    "Timer finished. Your Mac can sleep again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى المؤقت. يمكن للـ Mac الدخول في وضع السكون مجددًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporitzador ha acabat. El Mac pot tornar a repòs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovač skončil. Mac může znovu usnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeren er udløbet. Mac'en må gå i dvale igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer abgelaufen. Dein Mac darf wieder ruhen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το χρονόμετρο τελείωσε. Το Mac μπορεί πάλι να μπει σε ύπνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporizador ha terminado. El Mac puede volver a reposo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajastin päättyi. Mac voi taas mennä lepoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur est terminé. Le Mac peut de nouveau se mettre en veille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטיימר הסתיים. ה‑Mac יכול לישון שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमर समाप्त हुआ। Mac फिर से स्लीप हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjerač vremena je istekao. Mac ponovno može prijeći u pripravno stanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzítő lejárt. A Mac újra alhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer selesai. Mac Anda boleh tidur lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il timer è terminato. Il Mac può tornare in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーが終了しました。Macは再びスリープできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머가 종료되었습니다. Mac이 다시 잠자기에 들어갈 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasa tamat. Mac anda boleh tidur semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidtakeren er ferdig. Macen kan gå i dvale igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer afgelopen. Je Mac mag weer sluimeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutnik się zakończył. Mac może znów zostać uśpiony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O timer terminou. O Mac pode repousar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O temporizador terminou. O Mac pode voltar a entrar em pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporizatorul s-a terminat. Mac‑ul poate intra din nou în repaus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймер истек. Mac снова может уснуть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovač skončil. Mac môže znova zaspať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Timern är slut. Datorn får vila igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวจับเวลาสิ้นสุดแล้ว Mac สามารถพักเครื่องได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlayıcı bitti. Mac yeniden uyuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймер завершився. Mac знову може заснути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hết hẹn giờ. Máy Mac có thể ngủ lại."
