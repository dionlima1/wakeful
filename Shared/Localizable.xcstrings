    "All AI agents finished. Your Mac can sleep again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى جميع وكلاء الذكاء الاصطناعي. يمكن للـ Mac الدخول في وضع السكون مجددًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots els agents d’IA han acabat. El Mac pot tornar a repòs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všichni AI agenti skončili. Mac může znovu usnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle AI-agenter er færdige. Mac'en må gå i dvale igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle KI-Agenten sind fertig. Dein Mac darf wieder ruhen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλοι οι πράκτορες AI ολοκληρώθηκαν. Το Mac μπορεί πάλι να μπει σε ύπνο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los agentes de IA han terminado. El Mac puede volver a reposo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tekoälyagentit ovat valmiita. Mac voi taas mennä lepoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les agents IA ont terminé. Le Mac peut de nouveau se mettre en veille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל סוכני ה‑AI סיימו. ה‑Mac יכול לישון שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी AI एजेंट पूरे हो गए। Mac फिर से स्लीप हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi AI agenti su završili. Mac ponovno može prijeći u pripravno stanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden MI-ügynök végzett. A Mac újra alhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua agen AI selesai. Mac Anda boleh tidur lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli agenti IA hanno terminato. Il Mac può tornare in stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのAIエージェントが終了しました。Macは再びスリープできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 AI 에이전트가 끝났습니다. Mac이 다시 잠자기에 들어갈 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ejen AI selesai. Mac anda boleh tidur semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle KI-agenter er ferdige. Macen kan gå i dvale igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle AI-agents zijn klaar. Je Mac mag weer sluimeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy agenci AI zakończyli pracę. Mac może znów zostać uśpiony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os agentes de IA terminaram. O Mac pode repousar de novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os agentes de IA terminaram. O Mac pode voltar a entrar em pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toți agenții AI au terminat. Mac‑ul poate intra din nou în repaus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ИИ-агенты завершили работу. Mac снова может уснуть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetci AI agenti skončili. Mac môže znova zaspať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla AI-agenter är klara. Datorn får vila igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอเจนต์ AI ทั้งหมดทำงานเสร็จแล้ว Mac สามารถพักเครื่องได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm yapay zekâ ajanları bitti. Mac yeniden uyuyabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі ШІ-агенти завершили роботу. Mac знову може заснути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả tác nhân AI đã hoàn tất. Máy Mac có thể ngủ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 AI 智能体都已完成。Mac 可以重新睡眠了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 AI 代理程式都已完成。Mac 可以再次睡眠了。"
          }
        }
      }
    },
